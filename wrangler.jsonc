{
  "name": "fewbottles",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-05",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "fewbottles.com", "custom_domain": true },
    { "pattern": "www.fewbottles.com", "custom_domain": true },
    { "pattern": "drink.shoephone.net/*", "zone_name": "shoephone.net" }
  ]
}
